# Google AI Studio API key (used when GOOGLE_API_KEY is present)
# GOOGLE_API_KEY=AIza...

# OpenAI API key (used when OPENAI_API_KEY is present)
# OPENAI_API_KEY=sk-...

# xAI Grok API key (used when XAI_API_KEY is present)
# XAI_API_KEY=xai-...

# GitHub token with 'models' permission for GitHub Copilot AI access
# GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

# OpenWebUI/Ollama API key (used when OLLAMA_API_KEY is present)
# OLLAMA_API_KEY=ollama-...

# Discord bot token for `mmrpg-nai serve-discord`
# DISCORD_BOT_TOKEN=...
# DISCORD_CHANNEL_ID=123456789012345678

# Optional: override data directory (default: ./data)
# MMRPG_DATA_DIR=./data
